# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=your-super-secret-jwt-key-change-in-production

# Database (SQLite file based, for Docker volume)
# Prisma uses file:./dev.db by default, override if needed

# Email for forgot password (optional, falls back to console log)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=yourpassword
SMTP_FROM=noreply@yourdomain.com

# Upload limits
MAX_VIDEO_SIZE_MB=500

# Admin seed (first run creates admin if not exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123changeimmediately
